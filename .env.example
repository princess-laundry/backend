POSTGRES_DB=posture
POSTGRES_USER=posture
POSTGRES_PASSWORD=change-me

# Host ports
HTTP_PORT=8080
DB_HOST_PORT=5432

APP_LOG_LEVEL=INFO
APP_THREADS=0
DB_POOL_SIZE=4

# HS256 signing key, at least 32 characters. Generate one with:
# openssl rand -hex 32
JWT_SECRET=
# Access token lifetime in seconds (default 7 days, at most 30 days)
JWT_TTL_SEC=604800
