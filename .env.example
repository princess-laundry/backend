POSTGRES_DB=posture
POSTGRES_USER=posture
# Local development values. They work as is; replace both before any
# deployment that other people can reach.
POSTGRES_PASSWORD=local-dev-password

# Host ports
HTTP_PORT=8080
DB_HOST_PORT=5433

APP_LOG_LEVEL=INFO
APP_THREADS=0
DB_POOL_SIZE=4

# HS256 signing key, at least 32 characters. Generate one with:
# openssl rand -hex 32
JWT_SECRET=local-dev-jwt-secret-change-before-deploying
# Access token lifetime in seconds (default 7 days, at most 30 days)
JWT_TTL_SEC=604800

# Starts the HTTPS tunnel service with every `docker compose` command, which
# the Android app needs because it only connects over HTTPS. Remove this line
# if you only use http://localhost:8080.
COMPOSE_PROFILES=tunnel
